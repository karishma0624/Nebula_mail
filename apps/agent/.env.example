# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Gmail Pub/Sub (only needed if not using polling fallback)
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-notifications
GMAIL_PUBSUB_VERIFICATION_TOKEN=some-random-string-you-choose

# Supabase (backend uses service_role — full access, keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM — set whichever provider you're using
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# Misc
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=10
